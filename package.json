{
  "name": "sitesignal-seo-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "bullmq": "^5.41.9",
    "cheerio": "^1.0.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.3",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
